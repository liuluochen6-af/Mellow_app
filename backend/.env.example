DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/foodcheckin
APP_ENV=production
SMS_ACCESS_KEY_ID=your_aliyun_access_key
SMS_ACCESS_KEY_SECRET=your_aliyun_secret
# 中国大陆短信（SendSms）
SMS_SIGN_NAME=your_sms_sign
SMS_TEMPLATE_CODE=your_template_code
# 国际/港澳台短信（SendMessageToGlobe）。Sender ID 需按目标国家要求完成注册。
SMS_INTERNATIONAL_SENDER_ID=Mellow
SMS_INTERNATIONAL_MESSAGE_TEMPLATE=Your Mellow verification code is {code}. It expires in 5 minutes.
# 仅限本地开发；生产环境必须保持 false。
SMS_DEBUG_RETURN_CODE=false
# 必须与 iOS App 的 Bundle ID 一致。
APPLE_CLIENT_ID=com.foodcheckin.app
SECRET_KEY=your_random_secret_key_at_least_32_chars
